{
  "name": "foldkit-ssr-app-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --outDir dist/client",
    "start": "bun run server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111",
    "foldkit": "0.148.2"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.16.1",
    "@types/bun": "^1.4.0",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.0"
}
